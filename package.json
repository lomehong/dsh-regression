{
  "name": "@dsh-extra/dsh-regression",
  "version": "0.1.0",
  "description": "数字分身 · 人格回归：场景集 fixtures + dry-run 评估 + 报告存储（机制验证用 ScriptedRunner；HostRunner 由桌面壳/jobs 注入）。实施计划 T4。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.0"
  }
}